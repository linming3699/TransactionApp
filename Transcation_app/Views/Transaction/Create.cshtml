@model TransactionUpdateViewModel

@{
    ViewData["Title"] = "新增資料";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="validation-error"></div>
            <div class="form-group">
                <label asp-for="data.CreatedDateTime" class="control-label"></label>
                <input asp-for="data.CreatedDateTime" class="form-control" />
                <span asp-validation-for="data.CreatedDateTime" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="data.Amount" class="control-label"></label>
                <input asp-for="data.Amount" class="form-control" />
                <span asp-validation-for="data.Amount" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="data.Status" class="control-label"></label>
                <select asp-for="data.Status"
                        asp-items="Model.status"
                        class="form-select">
                </select>
                <span asp-validation-for="data.Status" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="data.Contents" class="control-label"></label>
                <input asp-for="data.Contents" class="form-control" />
                <span asp-validation-for="data.Contents" class="validation-error"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <form asp-action="Index">
        <input type="submit" value="回到列表" class="btn btn-danger" />
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");       }
}
