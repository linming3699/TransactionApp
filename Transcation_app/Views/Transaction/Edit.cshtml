@model TransactionUpdateViewModel

@{
    ViewData["Title"] = "編輯資料";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="data.Id" />
            <div class="form-group">
                <label asp-for="data.Amount" class="control-label"></label>
                <input asp-for="data.Amount" class="form-control" />
                <span asp-validation-for="data.Amount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="data.Status" class="control-label"></label>
                <select asp-for="data.Status"
                        asp-items="Model.status"
                        class="form-select">
                </select>
                <span asp-validation-for="data.Status" class="text-danger"></span>
            </div>
           @*  <div class="form-group">
                <label asp-for="data.Status" class="control-label"></label>
                <input asp-for="data.Status" class="form-control" />
                <span asp-validation-for="data.Status" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="data.CreatedDateTime" class="control-label"></label>
                <input asp-for="data.CreatedDateTime" class="form-control" />
                <span asp-validation-for="data.CreatedDateTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="data.Contents" class="control-label"></label>
                <input asp-for="data.Contents" class="form-control" />
                <span asp-validation-for="data.Contents" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="儲存修改" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <form asp-action="Index">
        <input type="submit" value="回到列表" class="btn btn-danger" />
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
